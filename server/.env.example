PORT=5000
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173,http://localhost:5174
DEFAULT_STORE_SLUG=demo
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_NAME=Store owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set only when running behind a trusted reverse proxy. Use the exact proxy hop count.
# TRUST_PROXY=1